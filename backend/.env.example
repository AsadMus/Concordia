# Copy to .env and fill in
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/conchordia
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Password reset: there's no email service yet, so the reset link is printed in the server terminal.
# true = also show the link on forgot-password.html (handy for demos). Set to false once real email is added.
SHOW_RESET_LINK=true
# Address used to build reset links (change when the app is deployed)
APP_URL=http://localhost:3000
